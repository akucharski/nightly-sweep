# Copy to .env and fill in. Keep .env out of version control.

# AI steps (triage and contradictions). The crawl runs without a key.
ANTHROPIC_API_KEY=
# XAI_API_KEY=

# A custom OpenAI-compatible provider reads its key from a line you name in the
# project settings, e.g. OPENAI_API_KEY, GROQ_API_KEY or OPENROUTER_API_KEY.
# Only keys in this file are used. Local models (Ollama, LM Studio) need none.
# OPENAI_API_KEY=

# Sign in with Google (optional). Create an OAuth client ID of type "Web application"
# in Google Cloud Console and register this redirect URI:
#   http://127.0.0.1:8765/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Anyone with a verified account in these Workspace domains may sign in (comma-separated).
# Leave empty to allow only people added with: manage.py add-user NAME --email ADDRESS
GOOGLE_ALLOWED_DOMAIN=
# Only if the dashboard runs at another address:
# GOOGLE_REDIRECT_URI=https://sweep.example.gov/auth/google/callback

# Set to 1 when serving the dashboard over HTTPS.
# COOKIE_SECURE=1
